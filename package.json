    "@types/react-dom": "^19.2.3",
    "typescript": "^4.9.5"
  },
  "jest": {
    "moduleNameMapper": {
      "^@rc-component/([^/]+)/(?!lib/|es/|assets/)(.+)$": "@rc-component/$1/lib/$2"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@ant-design|@rc-component|rc-[^/]+|antd|axios|react-photo-album|yet-another-react-lightbox)/)"
    ]
